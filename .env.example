# Copy to .env and fill in to run against real services.
# The mock demo needs none of these.

# Database (system of record for lead state + idempotency; Sheets are a
# human-facing projection). Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite+aiosqlite:///./leadflow.db

# Webhook signing (HMAC-SHA256, see app/security/webhook_auth.py)
WEBHOOK_SIGNING_SECRET=
BOLNA_WEBHOOK_SECRET=

# Google Sheets
SPREADSHEET_ID=
GOOGLE_CREDS_PATH=credentials.json

# Bolna (voice)
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# SMTP email
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDR=

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Payment provider (Razorpay/Stripe-style)
PAYMENT_WEBHOOK_SECRET=
